diff --git a/kr_trace.cpp b/kr_trace.cpp
new file mode 100644
index 0000000..5cb5394
--- /dev/null
+++ b/kr_trace.cpp
@@ -0,0 +1,28 @@
+#include "snes9x.h"
+#include "memmap.h"
+#include "ppu.h"
+#include "kr_trace.h"
+uint32 kr_rlo = 1, kr_rhi = 0, kr_wlo = 1, kr_whi = 0, kr_xlo = 1, kr_xhi = 0, kr_on = 0, kr_plo = 0, kr_phi = 0xFFFFFF;
+static KrEvent kr_buf[1 << 20];
+static uint32 kr_n = 0;
+void kr_log(uint32 kind, uint32 addr, uint32 val, uint32 extra)
+{
+	if (kr_n >= (1u << 20)) return;
+	KrEvent &e = kr_buf[kr_n++];
+	e.kind = kind; e.pbpc = Registers.PBPC; e.addr = addr; e.val = val; e.extra = extra;
+	e.a = Registers.A.W; e.x = Registers.X.W; e.y = Registers.Y.W; e.d = Registers.D.W; e.s = Registers.S.W;
+	e.db = Registers.DB; e.p = Registers.PL; e.pad0 = Registers.PH; e.pad1 = 0;
+}
+extern "C" {
+void retro_kr_set(uint32 rlo, uint32 rhi, uint32 wlo, uint32 whi, uint32 xlo, uint32 xhi, uint32 on)
+{ kr_rlo = rlo; kr_rhi = rhi; kr_wlo = wlo; kr_whi = whi; kr_xlo = xlo; kr_xhi = xhi; kr_on = on; }
+void retro_kr_pcfilter(uint32 lo, uint32 hi) { kr_plo = lo; kr_phi = hi; }
+uint32 retro_kr_count(void) { return kr_n; }
+void *retro_kr_buf(void) { return kr_buf; }
+void retro_kr_clear(void) { kr_n = 0; }
+void *retro_kr_vram(void) { return Memory.VRAM; }
+void *retro_kr_cgram(void) { return PPU.CGDATA; }
+void *retro_kr_oam(void) { return PPU.OAMData; }
+void *retro_kr_regs(void) { return &Registers; }
+void *retro_kr_fillram(void) { return Memory.FillRAM; }
+}
diff --git a/kr_trace.h b/kr_trace.h
new file mode 100644
index 0000000..ed5f872
--- /dev/null
+++ b/kr_trace.h
@@ -0,0 +1,10 @@
+#ifndef KR_TRACE_H
+#define KR_TRACE_H
+#include "port.h"
+struct KrEvent { uint32 kind, pbpc, addr, val; uint16 a, x, y, d, s; uint8 db, p, pad0, pad1; uint32 extra; };
+extern uint32 kr_rlo, kr_rhi, kr_wlo, kr_whi, kr_xlo, kr_xhi, kr_on, kr_plo, kr_phi;
+void kr_log(uint32 kind, uint32 addr, uint32 val, uint32 extra);
+#define KR_PCOK (Registers.PBPC >= kr_plo && Registers.PBPC <= kr_phi)
+#define KR_READ(addr, v) do { if (kr_on && (uint32)(addr) >= kr_rlo && (uint32)(addr) <= kr_rhi && KR_PCOK) kr_log(0, addr, v, 0); } while (0)
+#define KR_WRITE(addr, v) do { if (kr_on && (uint32)(addr) >= kr_wlo && (uint32)(addr) <= kr_whi && KR_PCOK) kr_log(1, addr, v, 0); } while (0)
+#endif
